extends Node

var udp := PacketPeerUDP.new()
var latest_peak := 0.0
const PORT := 4210

func _ready():
	var err = udp.bind(PORT)
	if err == OK:
		print("UDP listening on port ", PORT)
	else:
		print("UDP bind failed: ", err)

func _process(_delta):
	while udp.get_available_packet_count() > 0:
		var packet = udp.get_packet()
		var text = packet.get_string_from_utf8()
		var value = text.to_float()
		latest_peak = clamp(value, 0.0, 1.0)
		print("noise sent: ", text, " -> ", latest_peak) 

#after data is read it resets to 0
func consume_peak() -> float:
	var val = latest_peak
	latest_peak = 0.0
	return val
